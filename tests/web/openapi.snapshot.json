              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unknown folder, job or link"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One link by condition name",
        "tags": [
          "validate"
        ]
      }
    },
    "/api/repo": {
      "get": {
        "operationId": "repo_info_api_repo_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
