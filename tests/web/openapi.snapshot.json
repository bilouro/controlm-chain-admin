        "summary": "Repository summary",
        "tags": [
          "repo"
        ]
      }
    },
    "/api/validate": {
      "get": {
        "operationId": "validate_repo_api_validate_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Validate the repository",
        "tags": [
          "validate"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "The chain repository as a whole.",
      "name": "repo"
    },
    {
      "description": "Folders, their jobs, links and chain graph.",
      "name": "folders"
    },
    {
      "description": "One job with grouped attributes, ON blocks and links.",
      "name": "jobs"
    },
    {
      "description": "Validation findings and links by condition name.",
      "name": "validate"
    }
  ]
}
